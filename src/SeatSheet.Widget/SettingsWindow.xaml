<Window x:Class="SeatSheet.Widget.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SeatSheet.Widget" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="SeatSheet 设置" Width="860" Height="650" Style="{StaticResource {x:Type Window}}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F5F7FB" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="96" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="CheckFrame" Width="16" Height="16" VerticalAlignment="Center" Background="White" BorderBrush="#A5B2C6" BorderThickness="1" CornerRadius="4"><Path x:Name="Tick" Data="M3 7 L6 10 L12 4" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border><ContentPresenter x:Name="CheckContent" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="HasContent" Value="False"><Setter TargetName="CheckContent" Property="Margin" Value="0"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckFrame" Property="Background" Value="#245AE3"/><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#245AE3"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#245AE3"/><Setter TargetName="CheckFrame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#DCE3EF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="InputFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="#245AE3"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WidthThumb" TargetType="Thumb">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="White" BorderBrush="#245AE3" BorderThickness="4" CornerRadius="9"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WidthTrackButton" TargetType="RepeatButton">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HandleOption" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="OptionFrame" Background="#F8FAFD" BorderBrush="#E1E7F0" BorderThickness="2" CornerRadius="9" Padding="10"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="OptionFrame" Property="BorderBrush" Value="#245AE3"/><Setter TargetName="OptionFrame" Property="Background" Value="#F0F5FF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionFrame" Property="BorderBrush" Value="#245AE3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="OptionFrame" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <Border Background="#F8FAFD" BorderBrush="#DCE3EF" BorderThickness="1" CornerRadius="7"/>
     <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="Transparent">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#69758A"/></Grid></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,10,30,10" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
      <Border Background="White" BorderBrush="#DCE3EF" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E9EEF7"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E9F0FF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245AE3"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="RosterText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="RosterEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
  <Style x:Key="RosterCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/></Style>
  <Style x:Key="RosterCheckEdit" TargetType="CheckBox" BasedOn="{StaticResource RosterCheck}"><Setter Property="IsHitTestVisible" Value="True"/><Setter Property="Focusable" Value="True"/></Style>
 </Window.Resources>
 <Grid x:Name="SettingsSurface" Margin="28" RenderTransformOrigin="0.5,0.5">
  <Grid.RenderTransform><TranslateTransform x:Name="SettingsSlide"/></Grid.RenderTransform>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="偏好设置" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock x:Name="SettingsDescription" Text="连接班级座位表，调整适合课堂使用的显示大小。" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <ui:IconButton Grid.Column="1" Icon="close" Click="CancelClick" ToolTip="关闭设置" AutomationProperties.Name="关闭设置" Padding="8" Width="32" Height="32" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </Grid>
  <TabControl Grid.Row="1" x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" SelectionChanged="SettingsTabChanged">
   <TabControl.Resources>
    <Style TargetType="TabItem"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="20,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Height" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabFrame" Background="#E9EEF7" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{StaticResource Ink}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#245AE3"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,16"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
   </TabControl.Resources>
   <TabItem Header="常规">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="侧边把手" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="选择熟悉的文字标签，或更少遮挡的紧凑样式。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
      <UniformGrid x:Name="HandleOptions" Columns="3">
       <RadioButton x:Name="LabelOption" GroupName="HandleStyle" Style="{StaticResource HandleOption}" Margin="0,0,6,0" AutomationProperties.Name="座位标签">
        <StackPanel><Border Background="#E9EEF5" CornerRadius="5" Height="80"><ui:LauncherHandle Kind="label" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border><TextBlock Text="座位标签" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="清晰易认" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="SlimOption" GroupName="HandleStyle" Style="{StaticResource HandleOption}" Margin="3,0,3,0" AutomationProperties.Name="细长把手">
        <StackPanel><Border Background="#E9EEF5" CornerRadius="5" Height="80"><ui:LauncherHandle Kind="slim" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border><TextBlock Text="细长把手" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="占用最少" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="ArrowOption" GroupName="HandleStyle" Style="{StaticResource HandleOption}" Margin="6,0,0,0" AutomationProperties.Name="门形箭头">
        <StackPanel><Border Background="#E9EEF5" CornerRadius="5" Height="80"><ui:LauncherHandle Kind="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border><TextBlock Text="门形箭头" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="紧凑有指引" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
       </RadioButton>
      </UniformGrid>
     </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="座位表连接" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="填写你平时查看座位表的网站地址。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,16"/>
      <TextBlock Text="网站地址" FontSize="12" Margin="0,0,0,7"/>
      <TextBox x:Name="Address" ToolTip="SeatSheet 网站或服务地址"/>
      <TextBlock Text="格式示例：https://seats.example.com（请替换为自己的地址）" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,12" TextWrapping="Wrap"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="ConnectionState" Text="尚未验证连接" FontSize="12" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="Message" Text="更换网站时验证连接；外观设置可离线保存。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
       </StackPanel>
       <ui:IconButton x:Name="TestButton" Grid.Column="1" Icon="refresh" Label="测试连接" Click="TestClick" Padding="12,8" VerticalAlignment="Top"/>
      </Grid>
      <ProgressBar x:Name="ConnectionProgress" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="Collapsed" Foreground="#245AE3"/>
     </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18">
     <StackPanel>
      <Grid><TextBlock Text="面板显示" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="WidthValue" HorizontalAlignment="Right" Foreground="#245AE3" FontWeight="SemiBold" FontSize="16"/></Grid>
      <TextBlock Text="浮动面板宽度" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,12"/>
      <Slider x:Name="PanelWidth" Minimum="480" Maximum="1500" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="WidthChanged" Height="28">
       <Slider.Template><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent" VerticalAlignment="Center">
         <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource WidthTrackButton}" Background="#245AE3"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource WidthThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource WidthTrackButton}" Background="#E1E7F0"/></Track.IncreaseRepeatButton>
         </Track>
        </Grid>
       </ControlTemplate></Slider.Template>
      </Slider>
      <Grid Margin="0,5,0,0"><TextBlock Text="较窄" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="较宽" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
      <TextBlock x:Name="WidthHint" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
   </TabItem>
   <TabItem Header="随机点名">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="点名与通知" FontSize="16" FontWeight="SemiBold"/>
       <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="结果显示位置" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
        <ComboBox x:Name="RollCallOutput" SelectedIndex="0" Padding="8" FontSize="13" SelectionChanged="OutputSelectionChanged"><ComboBoxItem Content="本软件显示"/><ComboBoxItem Content="ClassIsland 显示"/><ComboBoxItem Content="两者同时"/></ComboBox>
        </StackPanel>
        <CheckBox Grid.Column="2" x:Name="NoRepeatOption" VerticalAlignment="Bottom" Margin="0,0,0,9"><TextBlock Text="本轮不重复（抽完后手动重置）" FontSize="12"/></CheckBox>
       </Grid>
       <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="PluginConnection" Text="尚未连接" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="通知失败会回退到本软件显示，重发不会重新抽人。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        <ui:IconButton Grid.Column="1" x:Name="ProbePluginButton" Icon="refresh" Label="检查插件" Click="ProbePluginClick" Padding="12,8" VerticalAlignment="Center"/>
       </Grid>
      </StackPanel>
     </Border>
     <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="参与名单" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RosterSummary" Text="尚未加载座位表" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ui:IconButton Icon="refresh" Label="更新名单" Click="RefreshRosterClick" Padding="12,8"/><Button Content="重置本轮" Click="ResetRoundClick" Padding="12,8" Margin="8,0,0,0"/></StackPanel>
     </Grid>
     <DataGrid Grid.Row="2" x:Name="ParticipantGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E7F0" RowHeaderWidth="0" BorderBrush="#E1E7F0" BorderThickness="1" Background="White" AlternatingRowBackground="#F8FAFD" RowHeight="36" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" FontSize="12">
      <DataGrid.Columns>
       <DataGridTextColumn Header="姓名" Binding="{Binding Name}" ElementStyle="{StaticResource RosterText}" IsReadOnly="True" Width="2*"/>
       <DataGridTextColumn Header="学号" Binding="{Binding StudentNo}" ElementStyle="{StaticResource RosterText}" IsReadOnly="True" Width="*"/>
       <DataGridTextColumn Header="座位" Binding="{Binding SeatLabel}" ElementStyle="{StaticResource RosterText}" IsReadOnly="True" Width="1.5*"/>
       <DataGridTextColumn Header="权重" Binding="{Binding Weight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" ElementStyle="{StaticResource RosterText}" EditingElementStyle="{StaticResource RosterEditor}" Width="*"/>
       <DataGridCheckBoxColumn Header="缺席" Binding="{Binding Absent, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource RosterCheck}" EditingElementStyle="{StaticResource RosterCheckEdit}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="3" x:Name="RollCallSettingsMessage" Text="空座不加入名单。权重为 0–100 的整数，0 或缺席均不参与；修改后点击保存设置。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,20,0,0">
   <TextBlock Text="SeatSheet · 桌面座位表" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelButton" Content="取消" Click="CancelClick"/>
    <ui:IconButton x:Name="SaveButton" Icon="check" Label="保存设置" Click="SaveClick" Background="#245AE3" Foreground="White" BorderBrush="#245AE3" Margin="8,0,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
