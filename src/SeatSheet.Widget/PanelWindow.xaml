<Window x:Class="SeatSheet.Widget.PanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SeatSheet.Widget"
 Title="SeatSheet 座位表" Width="920" Height="660" MinWidth="480" Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" KeyDown="WindowKeyDown">
 <Grid x:Name="PanelStage">
 <Grid x:Name="MotionRoot" RenderTransformOrigin="0.95,0.5">
 <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="MotionScale"/><TranslateTransform x:Name="MotionSlide"/></TransformGroup></Grid.RenderTransform>
 <Border x:Name="PanelShadow" Background="#1614233D" CornerRadius="24" Margin="10,13,10,7" IsHitTestVisible="False"/>
 <Border x:Name="PanelSurface" Background="#F5F7FB" BorderBrush="#DCE3EF" BorderThickness="1" CornerRadius="24" Margin="10">
 <Grid x:Name="PanelContent" Margin="15">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PanelHeader" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock x:Name="PlanTitle" Text="座位表" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="PlanStats" Text="连接你的班级，随时查看座位" Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="15" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <ui:IconButton x:Name="RefreshButton" Icon="refresh" Width="44" Height="40" Padding="8" Click="RefreshClick" ToolTip="刷新座位表" AutomationProperties.Name="刷新座位表"/>
     <ui:IconButton Icon="external" Label="管理座位" Click="ManageClick" MinHeight="40" Margin="8,0,0,0"/>
     <ui:IconButton Icon="settings" Label="设置" Click="SettingsClick" MinHeight="40" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ConnectionStatus" Text="正在连接" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="13" ToolTipService.ShowDuration="60000">
     <TextBlock.ToolTip><ToolTip MaxWidth="360"><StackPanel><TextBlock x:Name="ConnectionDetails" FontSize="14" TextWrapping="Wrap"/><TextBlock x:Name="UpdatedLabel" Margin="0,4,0,0" FontSize="14" Visibility="Collapsed"/><TextBlock x:Name="RollCallStatus" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/></StackPanel></ToolTip></TextBlock.ToolTip>
    </TextBlock>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Grid.RowSpan="2" Background="#EEF1F6" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="8"/>
  <Grid x:Name="FrontMarker" Grid.Row="1" HorizontalAlignment="Center" Margin="0,7,0,1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
   <Border Height="1" Background="#BEC8D6" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="教室前方" Margin="8,0" Foreground="#536581" FontSize="14"/>
   <Border Grid.Column="2" Height="1" Background="#BEC8D6" VerticalAlignment="Center"/>
  </Grid>
  <Grid x:Name="BoardRegion" Grid.Row="2" Margin="4,0,4,4">
   <ScrollViewer x:Name="BoardScroll" PanningMode="Both" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="BoardSizeChanged">
    <Canvas x:Name="BoardExtent" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid x:Name="Board" HorizontalAlignment="Left" VerticalAlignment="Top"><Grid.RenderTransform><ScaleTransform x:Name="BoardScale"/></Grid.RenderTransform></Grid></Canvas>
   </ScrollViewer>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330">
    <ui:VectorIcon Icon="seats" Width="52" Height="52" Foreground="#245AE3" HorizontalAlignment="Center"/>
    <TextBlock x:Name="EmptyTitle" Text="正在获取座位表…" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,8"/>
    <TextBlock Text="连接 SeatSheet 网站，即可在这里快速查看。" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
    <Button Content="设置服务地址" Click="SettingsClick" Margin="0,20,0,0"/>
   </StackPanel>
  </Grid>
  <DockPanel x:Name="PanelActions" Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
    <ui:IconButton Icon="minus" Click="ZoomOutClick" Width="44" Height="44" Padding="8" ToolTip="缩小座位表" AutomationProperties.Name="缩小座位表"/>
    <ui:IconButton Icon="plus" Click="ZoomInClick" Width="44" Height="44" Padding="8" Margin="8,0,0,0" ToolTip="放大座位表" AutomationProperties.Name="放大座位表"/>
    <ui:IconButton Icon="fit" Label="适应" Click="FitClick" Height="44" Padding="8,5" Margin="8,0,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <ui:IconButton x:Name="ExpandButton" Icon="expand" Label="展开" Click="ExpandClick" MinHeight="44" Padding="12,4"/>
    <ui:IconButton Icon="right" Label="收起" Click="CollapseClick" MinHeight="44" Padding="12,4" Margin="8,0,0,0"/>
    <ui:IconButton x:Name="RollCallButton" Icon="seats" Label="点名" Click="RollCallClick" MinHeight="44" Padding="12,4" Margin="8,0,0,0" Background="#245AE3" Foreground="White" BorderBrush="#245AE3" ToolTip="名单与权重在设置中调整"/>
   </StackPanel>
  </DockPanel>
 </Grid>
 </Border>
 </Grid>
 </Grid>
</Window>
