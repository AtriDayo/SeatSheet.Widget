<Window x:Class="SeatSheet.Widget.PanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SeatSheet.Widget"
 Title="SeatSheet 座位表" Width="920" Height="660" MinWidth="480" Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" KeyDown="WindowKeyDown">
 <Grid x:Name="PanelStage">
 <Grid x:Name="MotionRoot" RenderTransformOrigin="0.95,0.5">
 <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="MotionScale"/><TranslateTransform x:Name="MotionSlide"/></TransformGroup></Grid.RenderTransform>
 <Border x:Name="PanelShadow" Background="#1614233D" CornerRadius="18" Margin="10,13,10,7" IsHitTestVisible="False"/>
 <Border x:Name="PanelSurface" Background="#F5F7FB" BorderBrush="#DCE3EF" BorderThickness="1" CornerRadius="18" Margin="10">
 <Grid x:Name="PanelContent" Margin="28,24,28,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="SEATSHEET" Foreground="#245AE3" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="PlanTitle" Text="座位表" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <ui:IconButton x:Name="RollCallButton" Icon="seats" Label="点名" Click="RollCallClick" Margin="0,0,8,0" ToolTip="名单与权重在设置中调整"/>
    <ui:IconButton x:Name="RefreshButton" Icon="refresh" Label="刷新" Click="RefreshClick" ToolTip="获取最新座位表"/>
    <ui:IconButton Icon="right" Label="收起" Margin="8,0,0,0" Click="CollapseClick"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,18,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PlanStats" Text="连接你的班级，随时查看座位" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:IconButton Icon="fit" Label="适应" Click="FitClick" Padding="10,5"/><ui:IconButton Icon="minus" Click="ZoomOutClick" Margin="6,0,0,0" Padding="10,5" ToolTip="缩小座位表"/>
    <ui:IconButton Icon="plus" Click="ZoomInClick" Margin="6,0,0,0" Padding="10,5" ToolTip="放大座位表"/>
    <ui:IconButton x:Name="ExpandButton" Icon="expand" Label="展开" Click="ExpandClick" Margin="6,0,0,0" Padding="10,5"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="#E9EEFA" CornerRadius="7" Padding="12,8" Margin="0,0,0,16"><TextBlock Text="教 室 前 方" HorizontalAlignment="Center" Foreground="#536581" FontSize="12"/></Border>
  <Grid Grid.Row="3">
   <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="BoardSizeChanged">
    <Grid x:Name="Board" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid.LayoutTransform><ScaleTransform x:Name="BoardScale"/></Grid.LayoutTransform></Grid>
   </ScrollViewer>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330">
    <ui:VectorIcon Icon="seats" Width="52" Height="52" Foreground="#245AE3" HorizontalAlignment="Center"/>
    <TextBlock x:Name="EmptyTitle" Text="正在获取座位表…" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,8"/>
    <TextBlock Text="连接 SeatSheet 网站，即可在这里快速查看。" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
    <Button Content="设置服务地址" Click="SettingsClick" Margin="0,20,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="4" Margin="0,20,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="ConnectionStatus" Text="正在连接" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="UpdatedLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="RollCallStatus" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:IconButton Icon="external" Label="管理座位" Click="ManageClick"/><ui:IconButton Icon="settings" Label="设置" Click="SettingsClick" Margin="8,0,0,0"/></StackPanel>
  </Grid>
 </Grid>
 </Border>
 </Grid>
 <Canvas x:Name="ExpansionLayer" Visibility="Collapsed">
   <Border x:Name="ExpansionCard"><Image x:Name="ExpansionImage" Stretch="Fill"/></Border>
   <ui:IconButton x:Name="ExpansionToggle" Icon="restore" Label="还原" Click="ExpandClick" Padding="10,5"/>
 </Canvas>
 </Grid>
</Window>
