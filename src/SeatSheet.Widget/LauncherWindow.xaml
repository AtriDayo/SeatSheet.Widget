<Window x:Class="SeatSheet.Widget.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SeatSheet.Widget"
 Title="SeatSheet 按钮" Width="30" Height="72" Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
 <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonDown="PointerDown" MouseLeftButtonUp="PointerUp" MouseMove="PointerMove" ToolTip="点击查看座位表 · 拖动调整位置 · 右键打开菜单">
  <Grid.ContextMenu><ContextMenu><MenuItem Header="查看座位表" Click="OpenPanel"/><MenuItem Header="设置" Click="SettingsClick"/><Separator/><MenuItem Header="退出" Click="ExitClick"/></ContextMenu></Grid.ContextMenu>
  <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="0.82"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></Grid.Style>
  <ui:LauncherHandle x:Name="HandleVisual"/>
 </Grid>
</Window>
