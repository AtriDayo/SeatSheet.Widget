<Window x:Class="SeatSheet.Widget.RollCallResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SeatSheet.Widget" Title="SeatSheet 点名结果" Width="480" Height="320" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="Transparent" Topmost="True" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True">
 <Border x:Name="ResultSurface" Background="#F5F7FB" CornerRadius="18" BorderBrush="#DCE3EF" BorderThickness="1"><Grid Margin="24,16,24,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="Transparent" MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="SEATSHEET · 点名结果" Foreground="#245AE3" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><ui:IconButton Grid.Column="1" Icon="close" Click="CloseClick" Width="32" Height="32" Padding="8" Background="Transparent" BorderThickness="0" ToolTip="关闭" AutomationProperties.Name="关闭点名结果"/></Grid>
  <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12"><TextBlock x:Name="StudentName" FontSize="38" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="StudentDetails" FontSize="14" Foreground="{StaticResource Muted}" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,10,0,0"/></StackPanel>
  <TextBlock Grid.Row="2" x:Name="DeliveryState" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><ui:IconButton x:Name="RetryButton" Icon="refresh" Label="重发此结果" Click="RetryClick" Margin="0,0,8,0" MinHeight="38"/><Button x:Name="NextButton" Content="抽取下一位" Click="NextClick" MinHeight="38" Background="#245AE3" Foreground="White" BorderBrush="#245AE3"/></StackPanel>
 </Grid></Border>
</Window>
