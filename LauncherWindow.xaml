<Window x:Class="SeatSheet.Widget.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="SeatSheet 按钮" Width="30" Height="72" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
  <Border Background="#E9EDF3" BorderBrush="#BFC9D7" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Cursor="Hand"
    MouseLeftButtonDown="PointerDown" MouseLeftButtonUp="PointerUp" MouseMove="PointerMove" ToolTip="点击查看座位表 · 拖动调整位置 · 右键打开菜单">
    <Border.ContextMenu><ContextMenu><MenuItem Header="查看座位表" Click="OpenPanel"/><MenuItem Header="设置" Click="SettingsClick"/><Separator/><MenuItem Header="退出" Click="ExitClick"/></ContextMenu></Border.ContextMenu>
    <Border.Style><Style TargetType="Border">
      <Setter Property="Opacity" Value="0.82"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
    </Style></Border.Style>
    <Grid IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,0,0,0">
        <TextBlock Text="座" FontSize="13" FontWeight="SemiBold" Foreground="#46566E" TextAlignment="Center" HorizontalAlignment="Center" Height="21" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
        <TextBlock Text="位" FontSize="13" FontWeight="SemiBold" Foreground="#46566E" TextAlignment="Center" HorizontalAlignment="Center" Height="21" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
