<Window x:Class="SeatSheet.Widget.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SeatSheet 设置" Width="500" Height="410" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F5F7FB" Topmost="True">
 <StackPanel Margin="28">
  <TextBlock Text="连接你的座位表" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="填写 SeatSheet 网站地址，程序会自动获取座位表。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,22"/>
  <TextBlock Text="网站 / 服务地址" FontSize="13" Margin="0,0,0,8"/>
  <TextBox x:Name="Address" FontSize="15" Padding="10" BorderBrush="#DCE3EF"/>
  <TextBlock Text="例如 https://seats.atridayo.com 或 http://localhost:3000" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
  <TextBlock Text="面板宽度" FontSize="13"/>
  <Slider x:Name="PanelWidth" Minimum="480" Maximum="1500" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,12,0,10"/>
  <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#98621E" MinHeight="35" FontSize="12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" Click="CancelClick"/>
   <Button x:Name="SaveButton" Content="连接并保存" Click="SaveClick" Background="#245AE3" Foreground="White" BorderBrush="#245AE3" Margin="8,0,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
